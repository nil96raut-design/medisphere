{
  "info": {
    "name": "MediSphere HMS API",
    "description": "Complete API collection for MediSphere Hospital Management System\n\nEnvironments:\n- Local: http://localhost:8085\n- Auth: Bearer token from login\n\nDemo accounts (password: password123):\n- admin@medisphere.com\n- doctor@medisphere.com\n- receptionist@medisphere.com\n- nurse@medisphere.com\n- pharmacist@medisphere.com\n- labtech@medisphere.com\n- patient@medisphere.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "pm.collectionVariables.set('user_id', jsonData.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@medisphere.com\", \"password\": \"password123\"}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Register Patient User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"New Patient\", \"email\": \"newpatient@test.com\", \"password\": \"password123\", \"role\": \"PATIENT\", \"allergies\": \"none\"}"
            },
            "url": {"raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"]}
          }
        },
        {
          "name": "Hospital Signup",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"hospitalName\": \"New Hospital\", \"licenseNumber\": \"HOSP-NEW-001\", \"adminEmail\": \"admin@newhospital.com\", \"adminFullName\": \"Admin New\", \"adminPassword\": \"password123\"}"
            },
            "url": {"raw": "{{base_url}}/api/auth/hospital-signup", "host": ["{{base_url}}"], "path": ["api", "auth", "hospital-signup"]}
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"John\", \"lastName\": \"Doe\", \"phoneNumber\": \"555-0100\", \"gender\": \"Male\", \"dateOfBirth\": \"1990-01-15\"}"
            },
            "url": {"raw": "{{base_url}}/api/patients", "host": ["{{base_url}}"], "path": ["api", "patients"]}
          }
        },
        {
          "name": "Search Patients",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/patients/search?q=John", "host": ["{{base_url}}"], "path": ["api", "patients", "search"], "query": [{"key": "q", "value": "John"}]}
          }
        },
        {
          "name": "Log Triage Vitals",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"bloodPressure\": \"120/80\", \"temperatureCelsius\": 37.0, \"pulseRate\": 72, \"weightKg\": 70.5}"
            },
            "url": {"raw": "{{base_url}}/api/patients/1/triage", "host": ["{{base_url}}"], "path": ["api", "patients", "1", "triage"]}
          }
        }
      ]
    },
