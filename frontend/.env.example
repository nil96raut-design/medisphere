# ============================================
# MediSphere — Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# For Vercel deployment, set these as
# Environment Variables in the project settings.
# ============================================

# --- API Base URL ---
# In dev, omit this — Vite proxies /api to localhost:8085.
# In production, set to your deployed backend URL:
#   https://medisphere-backend.onrender.com/api
VITE_API_BASE_URL=/api

# --- Supabase (optional, for chat bot / auth) ---
# Only needed if you enable Supabase integration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key
