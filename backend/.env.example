# ============================================
# MediSphere — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# For production, set these as environment variables
# on your hosting platform (Render, Railway, etc.).
# ============================================

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medisphere
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT Authentication ---
# Generate a 256+ bit random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_256_BIT_RANDOM_SECRET

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Active Profile ---
# dev    = H2 in-memory DB, no Postgres needed
# prod   = PostgreSQL + Flyway migrations + production logging
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
# Render sets this automatically. Default: 8085
PORT=8085
